# Upbit Open API Keys (Required for Live Trading, optional when DRY_RUN=True)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# Trading Mode: True for Simulation (Safe Paper Trading), False for Live Trading
DRY_RUN=True

# LLM API Keys (At least one required for live AI analysis, otherwise automatic fallback runs)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# SQLite Database Path (Default: trading_ledger.db)
DB_PATH=trading_ledger.db

# Initial Total Capital for Simulation in KRW (Default: 1,000,000 KRW)
INITIAL_TOTAL_CAPITAL=1000000

# LLM Filter Worker Interval in seconds (Default: 3600 = 1 hour)
LLM_FILTER_INTERVAL_SEC=3600

# ========================================================
# Database Connection Location Mode: 'local' 또는 'outer'
# - local : 로컬 PC 내부 접속 (127.0.0.1:5432)
# - outer : 외부 인터넷 원격 접속 (218.234.55.78:5432 등)
# ========================================================
LOCATION=local

# --------------------------------------------------------
# [Local] 로컬 PC 내부 DB 접속 정보
# --------------------------------------------------------
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5432
LOCAL_PG_DATABASE=coin_trader
LOCAL_PG_USER=coin_trader
LOCAL_PG_PASSWORD=your_pg_password_here

# --------------------------------------------------------
# [Outer] 외부 인터넷 원격 DB 접속 정보 (공인 IP 또는 외부 도메인)
# --------------------------------------------------------
OUTER_PG_HOST=218.234.55.78
OUTER_PG_PORT=5432
OUTER_PG_DATABASE=coin_trader
OUTER_PG_USER=coin_trader
OUTER_PG_PASSWORD=your_pg_password_here

# Fallback 호환용
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=coin_trader
PGUSER=coin_trader
PGPASSWORD=your_pg_password_here
DATABASE_URL=postgresql://coin_trader:your_pg_password_here@127.0.0.1:5432/coin_trader
